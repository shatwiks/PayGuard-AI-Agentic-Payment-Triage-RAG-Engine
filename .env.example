# PayGuard AI Configuration Template
# Copy this file to .env and adjust values for your local or staging environment

# Application
APP_ENV=development
DEBUG=true
PROJECT_NAME="PayGuard AI: Agentic Payment Triage and RAG Engine"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payguard_user
POSTGRES_PASSWORD=payguard_secure_password
POSTGRES_DB=payguard_db
DATABASE_URL=postgresql+asyncpg://payguard_user:payguard_secure_password@localhost:5432/payguard_db
DATABASE_URL_SYNC=postgresql+psycopg://payguard_user:payguard_secure_password@localhost:5432/payguard_db

# Security & JWT Auth
# Generate secure key via: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_8f7b2a9e1d4c5e6f
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PII Masking
MASK_PII_ENABLED=true

# RAG & Embedding Settings (pgvector)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_TOP_K=3

# LLM Integration (Phase 3)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
