# PayGuard AI Configuration Template
# Copy this file to .env and adjust values for your local or staging environment

# Application
APP_ENV=development
DEBUG=true
PROJECT_NAME="PayGuard AI: Agentic Payment Triage and RAG Engine"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=payguard_user
POSTGRES_PASSWORD=payguard_secure_password
POSTGRES_DB=payguard_db
DATABASE_URL=postgresql+asyncpg://payguard_user:payguard_secure_password@localhost:5434/payguard_db
DATABASE_URL_SYNC=postgresql+psycopg://payguard_user:payguard_secure_password@localhost:5434/payguard_db

# Security & JWT Auth
# Generate secure key via: openssl rand -hex 32
SECRET_KEY=dev_secret_key_change_in_production_8f7b2a9e1d4c5e6f
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PII Masking
MASK_PII_ENABLED=true

# RAG & Embedding Settings (pgvector + Hybrid Search)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=15.0
RAG_TOP_K=5
RETRIEVAL_HYBRID_RRF_K=60
RETRIEVAL_LEXICAL_WEIGHT=1.0
RETRIEVAL_SEMANTIC_WEIGHT=1.0

# LLM Integration (Phase 5)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0

# Rate Limiting & Reliability (Phase 6)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=40
RATE_LIMIT_SEARCH_PER_MINUTE=60
REQUEST_MAX_BODY_BYTES=1048576
PROMPT_INJECTION_DEFENSE_ENABLED=true
INVESTIGATION_IDEMPOTENCY_WINDOW_SECONDS=15

