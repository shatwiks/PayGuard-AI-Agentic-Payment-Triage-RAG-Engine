# ==============================================================================
# PayGuard AI — Staging Environment Configuration Template (.env.staging.example)
# Copy to .env.staging and substitute real values before deployment.
# NEVER commit .env.staging or production secrets to Git!
# ==============================================================================

# Application Environment
APP_ENV=staging
DEBUG=false
PROJECT_NAME="PayGuard AI: Agentic Payment Triage and RAG Engine (Staging)"
VERSION=0.1.0

# Security & Authentication Secrets
# Generate using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_hex_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MASK_PII_ENABLED=true

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=payguard_staging_user
POSTGRES_PASSWORD=replace_with_strong_staging_db_password_min_16_chars
POSTGRES_DB=payguard_staging_db
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://payguard_staging_user:replace_with_strong_staging_db_password_min_16_chars@db:5432/payguard_staging_db

# CORS Configuration (Allowed Frontend Origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Frontend Configuration
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# OpenAI API Settings (Optional for Deterministic Offline Fallback Mode)
# Leave blank to operate in verified offline fallback mode
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Security & Reliability Controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_INVESTIGATIONS_PER_MINUTE=40
RATE_LIMIT_SEARCH_PER_MINUTE=60
REQUEST_MAX_BODY_BYTES=1048576
PROMPT_INJECTION_DEFENSE_ENABLED=true
INVESTIGATION_IDEMPOTENCY_WINDOW_SECONDS=15
